# Machine-specific settings for the ai-review capture script. Install at
# /etc/postdare-go/ai-review.env, or point POSTDARE_REVIEW_CONFIG elsewhere.
# Values here win over the environment; leave one out to set it per stage.

# Reviewer binary. Defaults to whatever "pi" resolves to on PATH, so pin it here
# only when it lives outside PATH -- note that an nvm path carries a Node version
# and breaks on the next upgrade.
#POSTDARE_REVIEW_PI_BIN=/root/.nvm/versions/node/v25.5.0/bin/pi

# Model the reviewer runs.
#POSTDARE_REVIEW_MODEL=litellm/glm-5.3-flash

# Optional skill directory. Unset means the reviewer runs without --skill.
#POSTDARE_REVIEW_SKILL_DIR=/root/xianhu/xianhu-server/.agents/skills/show-me
