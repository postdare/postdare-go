#!/usr/bin/env bash
set -euo pipefail

PI_BIN="/root/.nvm/versions/node/v25.5.0/bin/pi"
MODEL="litellm/glm-5.3-flash"
SKILL_DIR="/root/xianhu/xianhu-server/.agents/skills/show-me"
PROJECT_DIR="${POSTDARE_PROJECT_DIR:?POSTDARE_PROJECT_DIR is required}"
BASE_COMMIT="${POSTDARE_BEFORE_COMMIT_ID:-HEAD^}"
TARGET_COMMIT="${POSTDARE_COMMIT_ID:-HEAD}"

cd "$PROJECT_DIR"
if ! git rev-parse --verify "${BASE_COMMIT}^{commit}" >/dev/null 2>&1 || ! git rev-parse --verify "${TARGET_COMMIT}^{commit}" >/dev/null 2>&1; then
  printf '%s\n' '{"report_type":"ai_review","status":"failed","conclusion":"commit_missing","summary":"无法解析审查所需的基线或目标 commit。","issues":[],"markdown":"","error_message":"baseline or target commit is missing"}'
  exit 0
fi

DIFF_FILE="$(mktemp /tmp/postdare-ai-review.XXXXXX.diff)"
trap 'rm -f "$DIFF_FILE"' EXIT
git diff --no-ext-diff --unified=80 "${BASE_COMMIT}..${TARGET_COMMIT}" >"$DIFF_FILE"
if [[ ! -s "$DIFF_FILE" ]]; then
  printf '%s\n' '{"report_type":"ai_review","status":"skipped","conclusion":"no_changes","summary":"提交范围内没有可审查的代码变更。","issues":[],"markdown":"## 审查结果\n\n提交范围内没有代码差异。","error_message":""}'
  exit 0
fi

# The model never reproduces code: it reports a location, and attach_hunks cuts
# the matching excerpt out of the real diff below. An excerpt the model wrote
# could be hallucinated, which would make it worse than no excerpt at all.
PROMPT='审查附带的 git diff。只输出一个 JSON 对象，不要 Markdown 围栏或额外文字。结构必须是：{"report_type":"ai_review","status":"success","conclusion":"passed|issues_found","summary":"不超过240个中文字符","issues":[{"severity":"high|medium|low","title":"标题","location":"文件:行号","trigger":"触发条件","impact":"影响","suggestion":"建议"}],"markdown":"完整 Markdown 报告","error_message":""}。location 必须是 diff 中真实存在的“文件路径:行号”，行号以变更后的文件为准。不要输出 diff_hunk 字段，代码片段由调用方从真实 diff 中截取。只报告由本次 diff 引入且可验证的问题；没有问题时 issues 为空、conclusion 为 passed。Markdown 中可使用 GFM 和 Mermaid，但不要使用原始 HTML。'

ATTACH_HUNKS=$(cat <<'PYEOF'
import json, re, sys

MAX_LINES = 40
HUNK_RE = re.compile(r'^@@ -\d+(?:,\d+)? \+(\d+)(?:,(\d+))? @@')


def parse_diff(path):
    """Map each file in the diff to its hunks, keyed by new-side line range."""
    files, current = {}, None
    with open(path, encoding='utf-8', errors='replace') as handle:
        for raw in handle:
            line = raw.rstrip('\n')
            if line.startswith('+++ '):
                name = line[4:].strip()
                if name.startswith('b/'):
                    name = name[2:]
                current = files.setdefault(name, [])
            elif current is not None and HUNK_RE.match(line):
                match = HUNK_RE.match(line)
                start = int(match.group(1))
                span = int(match.group(2) or 1)
                current.append({'start': start, 'end': start + max(span, 1) - 1, 'lines': [line]})
            elif current and line[:1] in (' ', '+', '-', '\\'):
                current[-1]['lines'].append(line)
    return files


def find_hunk(files, location):
    match = re.match(r'^\s*(.+?):(\d+)', location or '')
    if not match:
        return ''
    path, number = match.group(1).strip(), int(match.group(2))
    for name, hunks in files.items():
        if not (name == path or name.endswith('/' + path) or path.endswith('/' + name)):
            continue
        for hunk in hunks:
            if hunk['start'] <= number <= hunk['end']:
                return '\n'.join(hunk['lines'][:MAX_LINES])
    return ''


def extract_json(text):
    """Pull the report object out of output that may carry prose or code fences.

    Instructing a model to emit only JSON does not reliably stop it from adding a
    sentence or a fence, and a report is too expensive to discard over that.
    """
    for start in (i for i, ch in enumerate(text) if ch == '{'):
        depth, in_string, escaped = 0, False, False
        for index in range(start, len(text)):
            ch = text[index]
            if in_string:
                if escaped:
                    escaped = False
                elif ch == '\\':
                    escaped = True
                elif ch == '"':
                    in_string = False
                continue
            if ch == '"':
                in_string = True
            elif ch == '{':
                depth += 1
            elif ch == '}':
                depth -= 1
                if depth == 0:
                    try:
                        return json.loads(text[start:index + 1])
                    except ValueError:
                        break
    raise ValueError('no JSON object in model output')


def fail(reason):
    """Emit a well-formed failed report rather than passing output through.

    The server cannot tell a real excerpt from one the model invented, so it
    trusts whatever this script sends. That trust only holds if the script never
    forwards output it did not process: a report is worth losing to keep
    fabricated code from being presented as evidence.
    """
    json.dump({
        'report_type': 'ai_review',
        'status': 'failed',
        'conclusion': 'enrichment_failed',
        'summary': 'AI 审查结果无法处理，未生成报告。',
        'issues': [],
        'markdown': '',
        'error_message': reason,
    }, sys.stdout, ensure_ascii=False)


raw = sys.stdin.read()
try:
    report = extract_json(raw)
except ValueError as error:
    fail('%s; output began %r' % (error, raw.strip()[:200]))
    sys.exit(0)

files = parse_diff(sys.argv[1])
for issue in report.get('issues') or []:
    if isinstance(issue, dict):
        # Drop anything the model supplied here before attaching the real hunk:
        # only an excerpt cut from the diff below may reach the report.
        issue.pop('diff_hunk', None)
        hunk = find_hunk(files, issue.get('location', ''))
        if hunk:
            issue['diff_hunk'] = hunk
json.dump(report, sys.stdout, ensure_ascii=False)
PYEOF
)

REPORT="$("$PI_BIN" \
  --model "$MODEL" \
  --skill "$SKILL_DIR" \
  --no-tools \
  --no-context-files \
  --no-extensions \
  --no-session \
  --print \
  "@$DIFF_FILE" \
  "$PROMPT")"

# Enrichment is mandatory, not best effort. Passing the model's output straight
# through would let a diff_hunk it invented reach the report as evidence, which
# is the one thing this pipeline must not do.
if ! command -v python3 >/dev/null 2>&1; then
  printf '%s\n' '{"report_type":"ai_review","status":"failed","conclusion":"enrichment_unavailable","summary":"缺少 python3，无法从真实 diff 截取代码摘录。","issues":[],"markdown":"","error_message":"python3 is required to attach diff excerpts"}'
  exit 0
fi
printf '%s' "$REPORT" | python3 -c "$ATTACH_HUNKS" "$DIFF_FILE"
printf '\n'
